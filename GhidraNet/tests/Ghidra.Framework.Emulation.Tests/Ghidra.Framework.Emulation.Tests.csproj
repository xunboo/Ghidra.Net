<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0078;CS0414;CS0168;CS0169;CS0693;CS8669;CS0472</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ghidra.Core\Ghidra.Core.csproj" />
    <ProjectReference Include="..\Ghidra.Test.Framework\Ghidra.Test.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Float and Utils from SoftwareModeling -->
    <Compile Include="..\..\src\Ghidra.Framework.SoftwareModeling\ghidra\pcode\floatformat\*.cs" Link="Dependencies\floatformat\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Ghidra.Framework.SoftwareModeling\ghidra\pcode\utils\Utils.cs" Link="Dependencies\Utils.cs" />
    <Compile Include="..\..\src\Ghidra.Framework.SoftwareModeling\ghidra\pcode\error\LowlevelError.cs" Link="Dependencies\LowlevelError.cs" />

    <!-- Pcode Model & Execution Engine Stubs -->
    <Compile Include="Stubs.cs" />

    <!-- OpBehavior Implementations -->
    <Compile Include="..\..\src\Ghidra.Framework.Emulation\ghidra\pcode\opbehavior\*.cs" Link="Implementation\opbehavior\%(Filename)%(Extension)" />

    <!-- OpBehavior Tests -->
    <Compile Include="ghidra\pcode\opbehavior\*.cs" />

    <!-- PcodeFrame Test -->
    <Compile Include="ghidra\pcode\exec\PcodeFrameTest.cs" />

    <!-- PcodeParser Test -->
    <Compile Include="..\Ghidra.Test.IntegrationTest.Tests\ghidra\program\model\lang\PcodeParserTest.cs" Link="PcodeParserTest.cs" />
  </ItemGroup>
</Project>
